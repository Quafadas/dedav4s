package build.calico

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.contrib.buildinfo.BuildInfo
import mill.api.BuildCtx

object `package` extends Module with build.CommonJs with build.PublishModule:
  def moduleDeps = Seq(build.core.js)
  override def artifactName = "dedav4s_calico"
  override def mvnDeps = super.mvnDeps() ++
    Seq(
      mvn"com.armanbilge::calico::0.2.3"
    )
  override def enableBsp = false

  object integration extends Module:
    object app extends build.CommonJs:
      def moduleDeps = Seq(build.calico)

      def moduleKind = ModuleKind.ESModule
      def moduleSplitStyle = ModuleSplitStyle.SmallModulesFor("calicointegrationapp")

      override def scalaJSImportMap = Seq(
        ESModuleImportMapping.Prefix("##vega-embed", "https://cdn.jsdelivr.net/npm/vega-embed@7/+esm"),
        ESModuleImportMapping.Prefix("##vega-view", "https://cdn.jsdelivr.net/npm/vega-view@5/+esm")
      )
    end app

    // A JVM module that drives the linked app in a browser. Like the laminar one, it must not depend on the Scala.js
    // modules: their jars on this classpath stop munit from running any tests.
    object test extends build.Common with build.SharedMunitTest with BuildInfo:

      val name = "dedav4s-calico"
      val buildInfoPackageName = "viz.calico"
      def buildInfoMembers = Task {
        Seq(
          BuildInfo.Value("pathToIndex", app.resources().head.path.toString),
          BuildInfo.Value("pathToJS", app.fastLinkJS().dest.path.toString),
          BuildInfo.Value("rootDir", BuildCtx.workspaceRoot.toString)
        )
      }

      override def forkArgs = Task {
        val _ = app.fastLinkJS() // Ensures linking happens before tests
        super.forkArgs()
      }

      override def mvnDeps = super.mvnDeps() ++
        Seq(
          mvn"org.typelevel::munit-cats-effect::2.2.0",
          mvn"io.github.quafadas::sjsls:0.14.17",
          mvn"com.microsoft.playwright:playwright:${build.Config.playwright}",
          mvn"com.microsoft.playwright:driver-bundle:${build.Config.playwright}",
          build.Config.oslib
        )
    end test
  end integration
end `package`
